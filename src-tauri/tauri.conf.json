{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Switchboard",
  "identifier": "dev.agent-switchboard.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Agent Switchboard",
        "label": "main",
        "width": 1180,
        "height": 780,
        "center": true,
        "minWidth": 940,
        "minHeight": 640,
        "decorations": false
      },
      {
        "label": "tray",
        "title": "Agent Switchboard",
        "url": "tray.html",
        "create": false,
        "focus": false,
        "visible": false,
        "width": 360,
        "height": 520,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": false,
        "windowEffects": {
          "effects": ["popover", "acrylic"],
          "state": "active",
          "radius": 20
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxRkQ5NkNENTQwQjEyNzkKUldSNUVndFV6WmI5c2F4dXlmcjlrbGN1bnBQQzhUN0xXWE0vZzZqYjQ0a01ZZDQ1cERQeWFDYkgK",
      "endpoints": [
        "https://github.com/y4Nkk/agent-switchboard/releases/latest/download/latest.json"
      ]
    }
  }
}
