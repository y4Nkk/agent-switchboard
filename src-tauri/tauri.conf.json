{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Switchboard",
  "identifier": "dev.agent-switchboard.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Agent Switchboard",
        "label": "main",
        "width": 1180,
        "height": 780,
        "center": true,
        "minWidth": 1080,
        "minHeight": 640,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "windowEffects": {
          "effects": ["underWindowBackground", "acrylic"],
          "state": "active"
        }
      },
      {
        "label": "tray",
        "title": "Agent Switchboard",
        "url": "tray.html",
        "create": false,
        "focus": false,
        "visible": false,
        "width": 480,
        "height": 520,
        "maxHeight": 560,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": false,
        "windowEffects": {
          "effects": ["popover", "acrylic"],
          "state": "active",
          "radius": 20
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "y4Nkk",
    "homepage": "https://github.com/y4Nkk/agent-switchboard",
    "copyright": "Copyright (c) 2026 y4Nkk",
    "resources": {
      "../CHANGELOG.md": "CHANGELOG.md",
      "vendor/wqy-zenhei/": "licenses/wqy-zenhei/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxRkQ5NkNENTQwQjEyNzkKUldSNUVndFV6WmI5c2F4dXlmcjlrbGN1bnBQQzhUN0xXWE0vZzZqYjQ0a01ZZDQ1cERQeWFDYkgK",
      "endpoints": [
        "https://github.com/y4Nkk/agent-switchboard/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive",
        "installerArgs": []
      }
    }
  }
}
