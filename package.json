{
  "name": "agent-switchboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env ASB_WEB_DEVELOPMENT=1 tauri dev",
    "dev:desktop": "cross-env ASB_WEB_DEVELOPMENT= CARGO_TARGET_DIR=target-dev tauri dev",
    "dev:frontend": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:updater-release": "node --test scripts/updater-release.test.mjs",
    "tauri": "tauri",
    "tauri:build:windows": "tauri build --config src-tauri/tauri.windows.conf.json",
    "msix:package": "pwsh -NoProfile -File scripts/package-msix.ps1 -ExecutablePath target/release/agent-switchboard.exe -WebView2LoaderPath target/release/WebView2Loader.dll",
    "msix:build": "npm run tauri:build:windows && npm run msix:package",
    "tauri:build:macos": "tauri build --config src-tauri/tauri.macos.conf.json",
    "tauri:build:linux": "tauri build --config src-tauri/tauri.linux.conf.json"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@remixicon/react": "^4.9.0",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "react": "^19.1.0",
    "react-aria-components": "^1.21.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.9.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.5.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
