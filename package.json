{
  "name": "agent-switchboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env ASB_WEB_DEVELOPMENT=1 tauri dev",
    "dev:desktop": "cross-env ASB_WEB_DEVELOPMENT= CARGO_TARGET_DIR=target-dev tauri dev",
    "dev:frontend": "npm run fonts:sync && vite",
    "fonts:sync": "node scripts/sync-fonts.mjs",
    "icons:sync": "node scripts/sync-app-icons.mjs",
    "build": "npm run fonts:sync && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "ci": "node scripts/ci.mjs",
    "verify-notes": "node scripts/verify-agent-note-tree.ts && node scripts/verify-agent-note-format.ts && node scripts/verify-archived-agent-notes.ts",
    "prune:local": "pwsh -NoProfile -File scripts/prune-local-artifacts.ps1",
    "archive-note": "node scripts/archive-agent-note.ts",
    "tauri": "tauri",
    "tauri:build:windows": "npm run icons:sync && pwsh -NoProfile -File scripts/build-windows-installer.ps1",
    "tauri:build:windows:msi": "npm run icons:sync && pwsh -NoProfile -File scripts/build-windows-installer.ps1 -Engine Msi",
    "msix:package:raw": "pwsh -NoProfile -File scripts/package-msix.ps1 -ExecutablePath target/release/agent-switchboard.exe -WebView2LoaderPath target/release/WebView2Loader.dll",
    "msix:package": "npm run icons:sync && npm run msix:package:raw",
    "msix:build": "npm run tauri:build:windows && npm run msix:package:raw",
    "tauri:build:macos": "npm run icons:sync && tauri build --config src-tauri/tauri.macos.conf.json",
    "tauri:build:linux": "npm run icons:sync && tauri build --config src-tauri/tauri.linux.conf.json"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "lucide-react": "^1.41.0",
    "react": "^19.1.0",
    "react-aria": "^3.52.1",
    "react-aria-components": "^1.21.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-stately": "^3.50.0",
    "recharts": "^3.9.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "2.1.275",
    "@iarna/toml": "2.2.5",
    "@openai/codex": "0.155.0",
    "@tauri-apps/cli": "^2.5.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
